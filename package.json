{
    "name": "tingly-git",
    "displayName": "Tingly Git",
    "description": "Git add files/folders via right-click context menu, view file history logs, and manage .gitignore and LICENSE — all without leaving the editor",
    "version": "0.260415.0",
    "author": {
        "name": "Tingly"
    },
    "repository": {
        "url": "https://github.com/FFengIll/vscode-tingly-git"
    },
    "publisher": "tingly-dev",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "resource/gear-stick-pattern.png",
    "activationEvents": [
        "workspaceContains:.git",
        "onCommand:tingly-git.addRemote",
        "onCommand:tingly-git.addFile",
        "onCommand:tingly-git.logCurrentFile",
        "onCommand:tingly-git.gitignore",
        "onCommand:tingly-git.license"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "tingly-git.addFile",
                "title": "Add File/Directory",
                "category": "Tingly Git"
            },
            {
                "command": "tingly-git.addRemote",
                "title": "Add Remote",
                "category": "Tingly Git"
            },
            {
                "command": "tingly-git.logCurrentFile",
                "title": "Log Current File",
                "category": "Tingly Git"
            },
            {
                "command": "tingly-git.gitignore",
                "title": "Manage .gitignore",
                "category": "Tingly Git"
            },
            {
                "command": "tingly-git.license",
                "title": "Manage LICENSE",
                "category": "Tingly Git"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "tingly-git.addFile",
                    "group": "Tingly Git"
                }
            ],
            "editor/context": [
                {
                    "command": "tingly-git.addFile",
                    "group": "Tingly Git"
                },
                {
                    "command": "tingly-git.logCurrentFile",
                    "group": "Tingly Git"
                }
            ],
            "editor/title/context": [
                {
                    "command": "tingly-git.addFile",
                    "group": "Tingly Git",
                    "when": "resourceExtname"
                },
                {
                    "command": "tingly-git.logCurrentFile",
                    "group": "Tingly Git",
                    "when": "resourceExtname"
                }
            ]
        },
        "keybindings": [
            {
                "command": "tingly-git.addFile",
                "key": "ctrl+shift+a",
                "mac": "cmd+shift+a",
                "when": "editorIsOpen || explorerViewletFocus"
            },
            {
                "command": "tingly-git.addFile",
                "key": "ctrl+shift+a",
                "mac": "cmd+shift+a",
                "when": "explorerResourceIsFolder || explorerResourceIsRoot"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "dependencies": {
        "simple-git": "^3.20.0"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "eslint": "^9.36.0",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2"
    }
}